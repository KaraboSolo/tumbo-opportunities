# Edge Function secrets. Set with:  npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real file.

GEMINI_API_KEY=
GEMINI_MODEL_PARSE=gemini-3.5-flash-lite
GEMINI_MODEL_RERANK=gemini-3.8-flash
GEMINI_MODEL_EMBED=gemini-embedding-2
GEMINI_EMBED_DIM=768
# Optional thinking controls. Set whichever your model supports (check the docs).
# GEMINI_THINKING_LEVEL=low
# GEMINI_THINKING_BUDGET=0

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna default limits: 25/minute, 250/day, 1000/week, 2500/month. 80/day keeps under the monthly cap.
ADZUNA_DAILY_CALL_LIMIT=80
ADZUNA_CALL_INTERVAL_MS=2600

# Zoho CPaaS email (SMTP/API > API tab of your Agent > Send Mail Token).
ZOHO_CPAAS_EMAIL_TOKEN=
# Change only if your account is on another Zoho data centre.
ZOHO_CPAAS_HOST=https://cpaas.zoho.com
# Must be on a domain verified in your CPaaS Agent.
EMAIL_FROM_ADDRESS=jobs@example.co.za
EMAIL_FROM_NAME=Tumbo Opportunities
COMPANY_CONTACT=Tumbo · support@example.co.za

# Public URL of the front end (Netlify), used in email links and redirects.
SITE_URL=http://localhost:5173

# Shared secret for cron and function-to-function calls. Also store it in Vault (see README).
CRON_SECRET=
# Secret used to sign unsubscribe links.
UNSUBSCRIBE_SECRET=

MATCH_MIN_SCORE=65
MATCH_MAX_RESULTS=10
