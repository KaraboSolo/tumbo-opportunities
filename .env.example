# Browser (Vite). Only these values ever reach the browser.
VITE_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: Cloudflare Turnstile site key (public). Leave empty to hide the CAPTCHA
# locally. Enable Turnstile in Supabase Auth settings with the matching secret.
VITE_TURNSTILE_SITE_KEY=
